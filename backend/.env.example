# ==============================================================================
# Vercel Production Environment Variables for Backend Project
# (Copy variable names into: Vercel Dashboard -> Backend Project -> Settings -> Environment Variables)
# ==============================================================================

# Neon Serverless PostgreSQL Database Connection String
DATABASE_URL=postgresql://user:password@ep-xyz.aws.neon.tech/neondb?sslmode=require

# Secure random secret for session encryption (AUD-07)
SESSION_SECRET=your_secure_session_secret_here

# Node environment mode
NODE_ENV=production

# Your frontend deployment URL on Vercel
FRONTEND_URL=https://flatmate-expense-tracker-lemon.vercel.app

# Google Gemini API Key for Voice Assistant and Smart Parsing
GEMINI_API_KEY=your_gemini_api_key_here
