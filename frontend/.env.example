# ==============================================================================
# Vercel Production Environment Variables for Frontend Project
# (Vercel Dashboard -> Frontend Project -> Settings -> Environment Variables)
# ==============================================================================

# Recommended: Leave blank.
# When left blank, all /api/* requests use Vercel's zero-CORS same-origin proxy
# defined in frontend/vercel.json forwarding directly to:
# https://flatmate-expense-tracker-backend.vercel.app/api/:path*
VITE_API_URL=faltamate-expense.vercel.app 

# Note: If you ever want to bypass the Vercel proxy and hit the backend directly,
# you can set:
# VITE_API_URL=https://flatmate-expense-tracker-backend.vercel.app
